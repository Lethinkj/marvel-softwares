# Google Analytics 4 (GA4) Measurement ID
# Format: G-XXXXXXXXXX
# Example: VITE_GA_MEASUREMENT_ID=G-1234567890
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Project URL (find it at: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public Key (Project Settings → API → anon / public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# SMTP Email Configuration (Nodemailer)
# Automatically dispatches:
# 1. Thank-you & formal confirmation email to client upon form submission (with logo & summary)
# 2. Instant lead notification email to admin/sales team
# ==============================================================================
# Outgoing SMTP Host (e.g. smtp.gmail.com, smtp.office365.com, smtp.zoho.in, mail.marvelsoftwares.in)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS/STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to true for SSL (port 465), or false for TLS/STARTTLS (port 587)
SMTP_SECURE=false

# SMTP Username / Account Email (e.g. sales@marvelsoftwares.in or your Gmail)
SMTP_USER=your-email@gmail.com

# SMTP Password or App Password (For Gmail: Google Account -> Security -> 2-Step -> App Passwords)
SMTP_PASS=your-app-password-here

# Sender Display Name
SMTP_FROM_NAME="MARVEL SOFTWARES"

# From Email Address (must match authorized sender of your SMTP provider)
SMTP_FROM_EMAIL=sales@marvelsoftwares.in

# Admin Email Address to receive new consultation / project inquiry notifications
ADMIN_NOTIFICATION_EMAIL=sales@marvelsoftwares.in

