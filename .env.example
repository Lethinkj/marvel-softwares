# Google Analytics 4 (GA4) Measurement ID
# Format: G-XXXXXXXXXX
# Example: VITE_GA_MEASUREMENT_ID=G-1234567890
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Project URL (find it at: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public Key (Project Settings → API → anon / public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
